{
  "name": "vite_react_shadcn_ts",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/postbuild-seo.mjs",
    "build:dev": "vite build --mode development",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "E2E_SUITE=public playwright test",
    "test:e2e:staging": "E2E_SUITE=staging playwright test",
    "test:e2e:check-env": "E2E_SUITE=staging node --input-type=module -e \"import { resolveE2EEnvironment } from './scripts/e2e-environment.mjs'; resolveE2EEnvironment();\"",
    "test:e2e:ui": "E2E_SUITE=public playwright test --ui",
    "test:test-env": "node --test scripts/e2e-environment.test.mjs scripts/e2e-results.test.mjs scripts/verify-speech-services.test.mjs tests/e2e/speech/converter-worker.test.mjs",
    "is-it-live": "node scripts/is-it-live.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.e2e.json && bun run typecheck:harness",
    "typecheck:e2e": "tsc --noEmit -p tsconfig.e2e.json",
    "qa": "bun run test:qa-gates && bun run test:speech:handlers && bun run test:test-env && bun run lint && bun run test && bun run typecheck && bun run test:e2e && bun run test:e2e:speech",
    "qa:release": "bun run test:e2e:check-env && bun run test:speech:services:check-env && bun run qa && bun run test:e2e:staging && bun run test:speech:services",
    "prerender": "node scripts/postbuild-seo.mjs",
    "verify:dist": "node scripts/verify-dist.mjs",
    "verify:live": "node scripts/verify-live.mjs",
    "worksheets:pdf": "node scripts/generate-worksheet-pdf.mjs",
    "test:speech": "vitest run src/lib/speech src/types/utteranceAnalysis.test.ts src/hooks/usePronunciationAnalysis.test.tsx src/hooks/__tests__/useUtteranceLogger.metrics.test.tsx src/contexts/LiveAnalysisContext.test.tsx src/components/live-analysis/SpeechAnalysisCard.test.tsx src/hooks/useSpeechRecognition.test.tsx src/hooks/__tests__/speechEndDetection.patience.test.ts src/hooks/useConversationSpeechAnalysis.test.tsx src/hooks/__tests__/pronunciationAnalytics.metrics.test.tsx src/components/PronunciationScoreCard.test.tsx src/components/PronunciationAnalyticsDashboard.test.tsx src/hooks/__tests__/useUtteranceLogger.timing.test.tsx src/hooks/__tests__/responseTiming.readers.test.tsx src/components/__tests__/sessionResponseTiming.test.tsx src/components/patient-hub/review/__tests__/responseTimingEvidence.test.tsx",
    "test:e2e:speech": "E2E_SUITE=public PLAYWRIGHT_PORT=4175 playwright test --config tests/e2e/speech/playwright.config.ts",
    "test:speech:services:check-env": "node scripts/verify-speech-services.mjs --check-env",
    "test:speech:services": "node scripts/verify-speech-services.mjs --run",
    "typecheck:harness": "tsc --noEmit -p tests/e2e/speech/tsconfig.harness.json",
    "test:response-timing": "vitest run src/lib/speech/responseTiming.test.ts src/hooks/__tests__/useUtteranceLogger.timing.test.tsx src/hooks/__tests__/responseTiming.readers.test.tsx src/components/__tests__/sessionResponseTiming.test.tsx src/components/patient-hub/review/__tests__/responseTimingEvidence.test.tsx",
    "test:qa-gates": "node --test scripts/qa-gates.test.mjs",
    "test:speech:handlers": "node --test scripts/speech-edge-handlers.test.mjs"
  },
  "dependencies": {
    "@hookform/resolvers": "^3.10.0",
    "@radix-ui/react-accordion": "^1.2.11",
    "@radix-ui/react-alert-dialog": "^1.1.14",
    "@radix-ui/react-aspect-ratio": "^1.1.7",
    "@radix-ui/react-avatar": "^1.1.10",
    "@radix-ui/react-checkbox": "^1.3.2",
    "@radix-ui/react-collapsible": "^1.1.11",
    "@radix-ui/react-context-menu": "^2.2.15",
    "@radix-ui/react-dialog": "^1.1.14",
    "@radix-ui/react-dropdown-menu": "^2.1.15",
    "@radix-ui/react-hover-card": "^1.1.14",
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-menubar": "^1.1.15",
    "@radix-ui/react-navigation-menu": "^1.2.13",
    "@radix-ui/react-popover": "^1.1.14",
    "@radix-ui/react-progress": "^1.1.7",
    "@radix-ui/react-radio-group": "^1.3.7",
    "@radix-ui/react-scroll-area": "^1.2.9",
    "@radix-ui/react-select": "^2.2.5",
    "@radix-ui/react-separator": "^1.1.7",
    "@radix-ui/react-slider": "^1.3.5",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-switch": "^1.2.5",
    "@radix-ui/react-tabs": "^1.1.12",
    "@radix-ui/react-toast": "^1.2.14",
    "@radix-ui/react-toggle": "^1.1.9",
    "@radix-ui/react-toggle-group": "^1.1.10",
    "@radix-ui/react-tooltip": "^1.2.7",
    "@supabase/supabase-js": "^2.81.1",
    "@tanstack/react-query": "^5.83.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^3.6.0",
    "embla-carousel-react": "^8.6.0",
    "input-otp": "^1.4.2",
    "jsdom": "^20.0.3",
    "lucide-react": "^0.462.0",
    "next-themes": "^0.3.0",
    "react": "^18.3.1",
    "react-day-picker": "^8.10.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.61.1",
    "react-markdown": "^10.1.0",
    "react-resizable-panels": "^2.1.9",
    "react-router-dom": "^6.30.1",
    "recharts": "^2.15.4",
    "sonner": "^1.7.4",
    "tailwind-merge": "^2.6.0",
    "tailwindcss-animate": "^1.0.7",
    "vaul": "^0.9.9",
    "vitest": "^3.2.4",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/js": "^9.32.0",
    "@playwright/test": "^1.60.0",
    "@tailwindcss/typography": "^0.5.16",
    "@testing-library/dom": "^10.4.1",
    "@types/node": "^22.16.5",
    "@types/react": "^18.3.23",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react-swc": "^3.11.0",
    "autoprefixer": "^10.4.21",
    "eslint": "^9.32.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^15.15.0",
    "lovable-tagger": "^1.1.11",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.38.0",
    "vite": "^5.4.19"
  }
}
