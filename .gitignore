# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# The tracked .env holds ONLY public values (Supabase URL + anon key — also
# hardcoded in src/integrations/supabase/client.ts) and is read by CI and the
# deploy build. Real secrets belong in local env files, which stay ignored:
.env.local
.env.*.local

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
test-results/

# Scratch scripts written by the runtime-verification harness (rt-README.md).
# The harness itself is committed; individual one-off checks are not.
rt-check-*.mjs

# Ad-hoc runtime probes written while investigating (see rt-README.md).
rt-fs-*.mjs
rt-probe-*.mjs

# Build output from a variant build (agent-produced); never committed.
dist-ndsp
